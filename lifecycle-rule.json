{
  "Rules": [
    {
      "ID": "LifecycleDemo-TransitionLargeObjectsToStandardIA",
      "Filter": {
        "And": {
          "Prefix": "practice/lifecycle-demo/",
          "ObjectSizeGreaterThan": 131071
        }
      },
      "Status": "Enabled",
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        }
      ]
    }
  ]
}
